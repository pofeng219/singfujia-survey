rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} { 
      allow read, write: if false; 
    }

    // Primitive Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isVerifiedOwner(userId) {
      return isOwner(userId) && request.auth.token.email_verified == true;
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    function isValidUserDraft(data) {
      return data.keys().hasOnly([
          'house', 'land', 'factory', 'parking',
          'houseUpdatedAt', 'landUpdatedAt', 'factoryUpdatedAt', 'parkingUpdatedAt',
          'updatedAt'
        ])
        && data.updatedAt is timestamp
        && data.updatedAt == request.time
        && (!('house' in data) || data.house is map)
        && (!('land' in data) || data.land is map)
        && (!('factory' in data) || data.factory is map)
        && (!('parking' in data) || data.parking is map)
        && (!('houseUpdatedAt' in data) || data.houseUpdatedAt is timestamp)
        && (!('landUpdatedAt' in data) || data.landUpdatedAt is timestamp)
        && (!('factoryUpdatedAt' in data) || data.factoryUpdatedAt is timestamp)
        && (!('parkingUpdatedAt' in data) || data.parkingUpdatedAt is timestamp);
    }

    function isValidCaseDraft(data, userId) {
      return data.keys().hasAll(['ownerId', 'type', 'caseName', 'address', 'data', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'type', 'caseName', 'address', 'data', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && data.type is string
        && data.type in ['house', 'land', 'factory', 'parking']
        && data.caseName is string
        && data.caseName.size() <= 120
        && data.address is string
        && data.address.size() <= 200
        && data.data is map
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    match /userDrafts/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isVerifiedOwner(userId) && isValidId(userId) && isValidUserDraft(incoming());
      allow update: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserDraft(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'house', 'land', 'factory', 'parking',
          'houseUpdatedAt', 'landUpdatedAt', 'factoryUpdatedAt', 'parkingUpdatedAt',
          'updatedAt'
        ]);
      allow delete: if isVerifiedOwner(userId) && isValidId(userId);

      match /cases/{caseId} {
        allow get: if isOwner(userId)
          && isValidId(userId)
          && isValidId(caseId)
          && existing().ownerId == request.auth.uid;
        allow list: if isOwner(userId)
          && isValidId(userId)
          && existing().ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(caseId)
          && isValidCaseDraft(incoming(), userId)
          && incoming().createdAt == request.time;
        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(caseId)
          && isValidCaseDraft(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().type == existing().type
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['caseName', 'address', 'data', 'updatedAt']);
        allow delete: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(caseId)
          && existing().ownerId == request.auth.uid;
      }
    }
  }
}
